# 单隧道模式（只需填写 GRE_REMOTE 即可启动，其余均为标准 GRE 默认值）
GRE_NAME=gre-tunnel1
GRE_COMMENT=site-a
GRE_REMOTE=203.0.113.1
GRE_LOCAL=auto
# 若本机位于云主机 1:1 NAT 后，可选填写公网 IP；留空亦可从对端 Keepalive 自动学习
GRE_PUBLIC_IP=

# 隧道虚拟接口地址与静态路由（支持 IPv4 与 IPv6，逗号分隔）
GRE_ADDR=172.16.1.2/30
GRE_ROUTE=10.1.101.0/24

# GRE 协议与保活参数
GRE_MTU=auto
GRE_KEEPALIVE=10s,10
GRE_DSCP=inherit
GRE_DONT_FRAGMENT=no
GRE_CLAMP_TCP_MSS=true
GRE_ALLOW_FAST_PATH=true
GRE_DNS_REFRESH=60s
GRE_TX_MODE=auto
GRE_QUEUES=auto

# 构建镜像加速（可选）
# RUST_IMAGE=dx.aorz.kdns.fr/library/rust:1-alpine

# 多隧道模式示例（启用下面配置时请注释上方单隧道字段，或使用 --tunnel 参数）
# GRE_TUNNELS="name=gre-bj;remote=203.0.113.1;addr=172.16.1.2/30;route=10.1.101.0/24 | name=gre-hk;remote=hk.example.com;addr=172.16.2.2/30;mtu=1400;keepalive=00:00:05,5"
